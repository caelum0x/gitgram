# AITM API (manual launch template)
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Database
DATABASE_URL=postgresql://user:password@project.neon.tech/aitm?sslmode=require

# Networking / internal auth
INTERNAL_SECRET=CHANGE_ME_INTERNAL_SECRET
CORS_ORIGIN=https://timemachine.gitgram.app
WEBSITE_URL=https://timemachine.gitgram.app

# Billing / email / monitoring
# Use a sandbox organization access token for staging/testing.
# Polar sandbox is isolated from production. See docs/polar-payment-setup.md.
POLAR_ACCESS_TOKEN=
POLAR_MODE=production
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
POLAR_TEAM_PRODUCT_ID=
RESEND_API_KEY=
SENTRY_DSN=

# Optional integrations
CLERK_WEBHOOK_SECRET=
REDIS_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
BRAVE_SEARCH_API_KEY=

# Managed workers
ENABLE_WORKERS=true
DELETE_WORKER_ENABLED=true
RETENTION_WORKER_ENABLED=true
GC_WORKER_ENABLED=true

# GitNexus integration
GITNEXUS_URL=http://localhost:3001
# A2A protocol
AITM_A2A_AGENTS=[]
AITM_API_URL=http://localhost:3001

# Workspace
WORKSPACE_PATH=/path/to/your/project

# Beads task tracker binary
BEADS_BINARY=/path/to/aitimemachine/beads/bd

# Gitgram bridge (auto-post AITM events to Gitgram feed)
GITGRAM_API_URL=http://localhost:4000
GITGRAM_API_KEY=

# PAL MCP Python execution server
PAL_MCP_URL=http://localhost:3200
