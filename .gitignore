# Dependencies
node_modules/

# AITM bundled first-party engines (built by aitimemachine/scripts/build-engines.sh)
aitimemachine/bin/
aitimemachine/engines/
# Built engine binaries left inside vendored source dirs (regenerated by build-engines.sh)
aitimemachine/beads/bd
aitimemachine/git/git
aitimemachine/git/git-*
aitimemachine/**/*.node

# Third-party repos (not our code) — large, not part of the product
external/
aitimemachine/gemini-cli/

# Compiled native parser objects / large generated artifacts
*.o
*.a

# Build outputs
dist/
build/
lib/
.next/
out/
.expo/
.expo-shared/
web-build/

# Logs and runtime output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pm2.log

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# Local app/runtime state
.tmp/
tmp/
temp/
.cache/
.turbo/
.aitimemachine/
*.aitm
*.db
*.sqlite
*.sqlite3
.kb-credentials.json
.kb-indexer-state.json
.mega-indexer-state.json

# Test artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Private keys and certificates
*.pem
*.key
*.p8
*.p12
