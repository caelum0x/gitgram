{
  "name": "@gitgram/timemachine-api",
  "version": "1.0.0",
  "description": "Gitgram TimeMachine Cloud Sync API Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/ensure-local-env.mjs && node --import tsx src/server.ts",
    "dev:watch": "node scripts/ensure-local-env.mjs && tsx watch src/server.ts",
    "dev:clean": "node scripts/ensure-local-env.mjs && node --import tsx src/server.ts",
    "dev:nolisten": "node scripts/ensure-local-env.mjs && AITM_TEST_NO_LISTEN=1 node --import tsx src/server.ts",
    "build": "tsc",
    "build:engines": "bash ../scripts/build-engines.sh",
    "ensure:engines": "node scripts/ensure-engines.mjs",
    "prestart": "node scripts/ensure-engines.mjs",
    "start": "node dist/server.js",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:local": "AITM_TEST_NO_LISTEN=0 vitest run tests/integration",
    "test:integration:safe": "node scripts/run-integration-safe.mjs",
    "eval:universal-search": "tsx scripts/universal-search-eval.ts",
    "worker:delete-requests": "tsx scripts/process-delete-requests.ts",
    "worker:retention": "tsx scripts/process-retention.ts",
    "collector:ingest": "node scripts/ingest-adoption-evidence.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@aws-sdk/client-s3": "^3.600.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.0.2",
    "@polar-sh/sdk": "^0.30.0",
    "@sentry/node": "^8.0.0",
    "@upstash/context7-sdk": "*",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.0",
    "express": "^4.18.2",
    "gitnexus": "file:../gitnexus",
    "gitnexus-shared": "file:../gitnexus-shared",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "resend": "^6.9.1",
    "uuid": "^11.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.31.8",
    "supertest": "^7.2.2",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "ioredis": "^5.11.1"
  }
}
