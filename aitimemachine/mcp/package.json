{
  "name": "@gitgram/timemachine-mcp",
  "version": "2.0.0",
  "description": "MCP (Model Context Protocol) server for Gitgram TimeMachine - checkpoint, restore, and time-travel tools for AI coding assistants",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aitm-mcp": "dist/index.js",
    "aitm-mcp-client": "dist/client.js"
  },
  "mcpName": "com.gitgram/mcp-server",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc && chmod +x dist/index.js dist/client.js",
    "prepack": "npm run build",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "client": "node dist/client.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "dev:with-gitnexus": "GITNEXUS_URL=http://localhost:3001 AITM_GITNEXUS_ENABLED=1 node --loader ts-node/esm src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "time-machine",
    "checkpoint",
    "restore",
    "claude",
    "cursor",
    "windsurf",
    "coding-assistant"
  ],
  "author": "Gitgram",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitgram-ai/gitgram-ai"
  },
  "homepage": "https://timemachine.gitgram.app",
  "bugs": {
    "url": "https://github.com/gitgram-ai/gitgram-ai/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@gitgram/timemachine": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@upstash/context7-sdk": "*",
    "express": "^5.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.25.76",
    "gitnexus": "file:../gitnexus",
    "gitnexus-shared": "file:../gitnexus-shared"
  },
  "devDependencies": {
    "@babel/parser": "^7.25.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  }
}
