# Clerk Auth (get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# API URL
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# Internal secret for website <-> API communication
INTERNAL_SECRET=your-secret-here

# App URL (for redirects). Use :3002 when running alongside Gitgram web (:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Polar.sh (get from https://polar.sh/dashboard)
POLAR_ACCESS_TOKEN=polar_at_xxx
POLAR_MODE=sandbox
NEXT_PUBLIC_POLAR_PRO_PRODUCT_ID=prod_xxx
NEXT_PUBLIC_POLAR_TEAM_PRODUCT_ID=prod_xxx

# Sentry (error tracking, optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
