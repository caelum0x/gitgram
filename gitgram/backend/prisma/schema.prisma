// NEW SCHEMA - Repository-as-Account Architecture

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the debian/arm64 openssl-3 targets cover the
  // node:20-bookworm-slim (glibc) Docker runtime on x64 and arm64 respectively.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE: Account System
// ============================================

enum AccountType {
  USER
  REPOSITORY
  ORGANIZATION
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// Universal Account - can be User, Repository, or Organization
model Account {
  id          String      @id @default(cuid())
  type        AccountType
  username    String      @unique
  displayName String?
  avatar      String?
  bio         String?     @db.Text
  verified    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations based on type
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  repositoryId String?     @unique
  repository   Repository? @relation(fields: [repositoryId], references: [id])

  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Social features (available to all account types)
  posts    Post[]
  stories  Story[]
  reels    Reel[]
  comments Comment[]
  likes    Like[]

  followers Follow[] @relation("AccountFollowers")
  following Follow[] @relation("AccountFollowing")

  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")

  messageReactions MessageReaction[]

  @@index([type])
  @@index([username])
}

// ============================================
// USER: Individual developers
// ============================================

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String?
  username          String?  @unique
  displayName       String?
  avatar            String?
  avatarUrl         String?
  bio               String?  @db.Text
  role              UserRole @default(USER)
  githubId          String?  @unique
  githubUsername    String?
  githubAccessToken String?
  googleId          String?  @unique
  emailVerified     Boolean  @default(false)
  verified          Boolean  @default(false)
  isPrivate         Boolean  @default(false)
  // Viewer opt-in for author-self-labeled adult content. When false (default),
  // posts an author marked as adult (sexual/nudity/porn) are hidden from this
  // user's feed. See services/selfLabels.ts.
  adultContentEnabled Boolean @default(false)
  isBanned          Boolean  @default(false)
  bannedAt          DateTime?
  bannedReason      String?
  isSuspended       Boolean  @default(false)
  suspendedUntil    DateTime?
  suspendedReason   String?
  warningCount      Int      @default(0)
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  interests         String[] @default([])  // User interests for recommendations (e.g., "typescript", "react", "ai")
  location          String?
  latitude          Float?
  longitude         Float?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  lastActiveAt      DateTime?  // Last time the user produced any activity (post/comment/like)
  scheduledDeletion DateTime?  // Date when account will be deleted (30-day grace period)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Link to Account
  account Account?

  // User can manage multiple repositories
  managedRepos RepositoryManager[]

  // User can be part of organizations
  orgMemberships OrganizationMember[]

  // Content relations
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  stories         Story[]
  reels           Reel[]
  snippets        CodeSnippet[]
  unifiedComments UnifiedComment[]
  reelComments    ReelComment[]
  storyReplies    StoryReply[]
  storySettings   StorySettings?
  storyHighlights StoryHighlight[]

  // Social
  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  sessions      Session[]
  subscription  Subscription?
  twoFactorAuth TwoFactorAuth?

  // Phase 9 additions
  linkedAccounts LinkedAccount[]

  // Audit trail
  auditLogs AuditLog[]

  // Repository stars
  stars Star[]

  // Multi-account switching grants
  switchGrantsGranted  AccountSwitchGrant[] @relation("SwitchGrantOwner")
  switchGrantsReceived AccountSwitchGrant[] @relation("SwitchGrantTarget")

  @@index([email])
  @@index([githubId])
  @@index([username])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// ACCOUNT SWITCH GRANT: explicit, revocable authorization for one user
// (ownerUser) to switch into / assume the session of another user
// (targetUser). Enables true multi-account switching without sharing
// credentials. A grant must exist and be active for switchAccount to
// produce a session for a *different* user.
// ============================================

model AccountSwitchGrant {
  id           String    @id @default(cuid())
  ownerUserId  String // the user who is allowed to switch
  targetUserId String // the account they may switch into
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  ownerUser  User @relation("SwitchGrantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  targetUser User @relation("SwitchGrantTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, targetUserId])
  @@index([ownerUserId])
  @@index([targetUserId])
}

// ============================================
// REPOSITORY: GitHub repos as social accounts
// ============================================

model Repository {
  id       String @id @default(cuid())
  owner    String // GitHub owner
  name     String // GitHub repo name
  fullName String @unique // "owner/name"

  // Link to Account (social profile)
  account Account?

  // GitHub data
  description String?  @db.Text
  stars       Int      @default(0)
  forks       Int      @default(0)
  watchers    Int      @default(0)
  language    String?
  topics      String[]
  htmlUrl     String
  isPrivate   Boolean  @default(false) // mirrors GitHub repo visibility
  ownerAvatar String? // GitHub owner avatar URL (populated by sync)

  // Additional GitHub data
  openIssues    Int       @default(0)
  lastFetched   DateTime?
  score         Float     @default(0)
  trendingScore Float     @default(0)
  trending      Boolean   @default(false)
  status        String    @default("active")

  // Social stats
  reactionsCount Int @default(0)
  commentsCount  Int @default(0)
  postsCount     Int @default(0)
  followersCount Int @default(0)
  viewsCount     Int @default(0)

  // Claiming & Management
  claimedBy    String? // User ID who claimed
  claimedAt    DateTime?
  repositoryId String?
  managers     RepositoryManager[]

  // Organization ownership (a repo may be transferred under an org)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Content
  posts     Post[]
  reels     Reel[]
  stories   Story[]
  snippets  CodeSnippet[]
  followers RepositoryFollow[]

  // GitHub Webhooks & Activity
  webhook    GitHubWebhook?
  activities RepositoryActivity[]

  // AITM Change Story settings
  aitmSettings RepositoryAitmSettings?

  // Analytics
  starredBy        Star[]
  referrers        RepositoryReferrer[]
  pathViews        RepositoryPathView[]
  clones           RepositoryClone[]

  // Metadata
  lastSynced DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([owner, name])
  @@index([owner])
  @@index([claimedBy])
  @@index([organizationId])
  @@index([trending])
}

enum ManagerRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model RepositoryManager {
  id           String      @id @default(cuid())
  repositoryId String
  userId       String
  role         ManagerRole @default(EDITOR)
  createdAt    DateTime    @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
  @@index([userId])
}

// ============================================
// ORGANIZATION: Companies/Teams
// ============================================

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Link to Account
  account Account?

  // Organization data
  description String? @db.Text
  website     String?
  location    String?

  // Members
  members OrganizationMember[]

  // Repositories owned by this organization
  repositories Repository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ============================================
// SOCIAL: Posts, Stories, Reels
// ============================================

enum PostType {
  POST
  TEXT
  IMAGE
  VIDEO
  REEL
  STORY
  REPOSITORY
  CHANGE_STORY
}

model Post {
  id           String   @id @default(cuid())
  accountId    String // Can be user, repo, or org account
  userId       String?
  projectId    String?
  repositoryId String?
  content      String   @db.Text
  mediaUrls    String[]
  repoUrl        String?
  checkpointRef  String?   // AITM checkpoint ID for change story posts
  aitmCheckpointId  String?   @map("aitm_checkpoint_id")
  aitmProjectId     String?   @map("aitm_project_id")
  aitmCheckpointRef Json?     @map("aitm_checkpoint_ref")  // stores { sha, message, files, createdAt }
  type           PostType  @default(POST)
  status         String    @default("PUBLISHED") // PUBLISHED, DRAFT, SCHEDULED
  isArchived   Boolean  @default(false)
  archivedAt   DateTime?

  // Author self-labeling / content warnings (ported from Bluesky SELF_LABELS).
  // Voluntary, author-applied sensitivity tags. Each maps to a hide-or-warn
  // behavior in the feed pipeline. Adult labels (sexual, nudity, porn) hide by
  // default; graphic-media and spoiler warn (blur) by default.
  selfLabels     String[]  @default([]) // e.g. ["sexual", "graphic-media", "spoiler"]
  contentWarning String?   // optional free-text warning shown alongside the label

  // Detected spoken/natural language of the post body, as an ISO 639-1/639-2
  // code (e.g. "en", "es", "pt"). Distinct from programming-language fields on
  // Repository/Project. Used by the feed pipeline's preferredLangOnly tuner step
  // to filter content to a viewer's natural-language preferences. Null when the
  // language could not be detected; such posts are never filtered out.
  contentLanguage String?

  // Optional geotagging for map / nearby discovery
  location  String?
  latitude  Float?
  longitude Float?

  likesCount    Int @default(0)
  commentsCount Int @default(0)
  sharesCount   Int @default(0)
  viewsCount    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository   Repository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  comments     Comment[]
  likes        Like[]
  hashtags     PostHashtag[]
  savedBy      SavedPost[]
  linkPreviews LinkPreview[]
  views        PostView[]

  @@index([accountId])
  @@index([userId])
  @@index([repositoryId])
  @@index([checkpointRef])
  @@index([aitmCheckpointId])
  @@index([aitmProjectId])
  @@index([createdAt])
  @@index([isArchived])
  @@index([contentLanguage])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  accountId  String
  userId     String?
  parentId   String?  // For nested replies
  content    String   @db.Text
  likesCount Int      @default(0)
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId])
  @@index([parentId])
  @@index([accountId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  accountId String
  userId    String?
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, accountId])
  @@unique([postId, userId])
  @@index([postId])
  @@index([accountId])
  @@index([userId])
}

model Story {
  id           String   @id @default(cuid())
  accountId    String
  userId       String?
  repositoryId String?
  mediaUrl     String
  mediaType    String // image/video
  caption      String?  @db.Text
  viewsCount   Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  account    Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository Repository?     @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  views      StoryView[]
  reactions  StoryReaction[]
  replies    StoryReply[]

  @@index([accountId])
  @@index([userId])
  @@index([repositoryId])
  @@index([expiresAt])
}

model Reel {
  id            String   @id @default(cuid())
  accountId     String
  userId        String?
  repositoryId  String?
  title         String
  description   String?  @db.Text
  videoUrl      String
  thumbnailUrl  String
  duration      Int
  musicTrackId  String?
  musicTitle    String?
  musicArtist   String?
  musicPreviewUrl String?
  musicArtworkUrl String?
  musicStartTime Int?
  effectId      String?
  trimStart     Float?
  trimEnd       Float?
  thumbnailTime Float?
  isArchived    Boolean  @default(false)
  archivedAt    DateTime?
  viewsCount    Int      @default(0)
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  createdAt     DateTime @default(now())

  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository Repository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  likes      ReelLike[]
  comments   ReelComment[]
  views      ReelView[]

  @@index([accountId])
  @@index([userId])
  @@index([repositoryId])
  @@index([createdAt])
  @@index([isArchived])
}

// ============================================
// SOCIAL: Follow System
// ============================================

model Follow {
  id              String   @id @default(cuid())
  followerId      String // Account following
  followingId     String // Account being followed
  followerUserId  String?
  followingUserId String?
  createdAt       DateTime @default(now())

  follower      Account @relation("AccountFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following     Account @relation("AccountFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  followerUser  User?   @relation("UserFollowers", fields: [followerUserId], references: [id], onDelete: Cascade)
  followingUser User?   @relation("UserFollowing", fields: [followingUserId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@unique([followerUserId, followingUserId])
  @@index([followerId])
  @@index([followingId])
  @@index([followerUserId])
  @@index([followingUserId])
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id               String    @id @default(cuid())
  senderId         String
  receiverId       String
  chatId           String?
  content          String    @db.Text
  mediaUrl         String?
  read             Boolean   @default(false)
  readAt           DateTime? // Timestamp when message was read
  deliveredAt      DateTime? // Timestamp when message was delivered to recipient's client
  editedAt         DateTime?
  deletedForSender Boolean   @default(false)
  createdAt        DateTime  @default(now())

  sender   Account @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Account @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  chat     Chat?   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  reactions MessageReaction[]

  @@index([senderId])
  @@index([receiverId])
  @@index([chatId])
  @@index([createdAt])
  @@index([read])
}

// Emoji reactions on a direct/group message. A user may add at most one of each
// distinct emoji to a given message (enforced by the unique constraint), and the
// total number of distinct reactions per user per message is capped in the
// controller (mirroring Bluesky's per-message reaction limit).
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    Account @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  MESSAGE
  REPO_UPDATE
  STORY_REPLY
}

model Notification {
  id        String           @id @default(cuid())
  accountId String?
  userId    String?
  type      NotificationType
  actorId   String? // Account that triggered notification
  postId    String?
  content   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@unique([userId, id])
  @@index([accountId])
  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// ============================================
// ADDITIONAL MODELS FOR CONTROLLERS
// ============================================

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  tier                  String    @default("free")
  plan                  String?
  status                String    @default("active")
  polarCustomerId       String?   @unique
  polarSubscriptionId   String?   @unique
  currentPeriodEnd      DateTime?
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([polarCustomerId])
}

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  enabled     Boolean  @default(false)
  backupCodes String[]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodeSnippet {
  id           String   @id @default(cuid())
  accountId    String?
  userId       String?
  repositoryId String?
  title        String
  description  String?  @db.Text
  code         String   @db.Text
  language     String
  likesCount   Int      @default(0)
  viewsCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([userId])
  @@index([repositoryId])
  @@index([language])
}

model Hashtag {
  id        String        @id @default(cuid())
  name      String        @unique
  count     Int           @default(0)
  createdAt DateTime      @default(now())
  posts     PostHashtag[]

  @@index([count])
}

model PostHashtag {
  id        String   @id @default(cuid())
  postId    String
  hashtagId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([postId])
}

model SavedCollection {
  id              String                @id @default(cuid())
  accountId       String
  userId          String?
  name            String
  description     String?               @db.Text
  coverImage      String?
  isPrivate       Boolean               @default(false)
  isDefault       Boolean               @default(false)  // For "All Saved" default collection
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  posts           SavedPost[]
  savedPosts      SavedPost[]           @relation("CollectionPosts")
  savedPostLinks  SavedPostCollection[] // Many-to-many relation

  @@unique([userId, name])  // Prevent duplicate collection names per user
  @@index([accountId])
  @@index([userId])
  @@index([isDefault])
}

model SavedPost {
  id           String   @id @default(cuid())
  accountId    String?
  userId       String?
  postId       String
  collectionId String?  // Primary collection (backwards compatibility)
  savedAt      DateTime @default(now())
  createdAt    DateTime @default(now())

  post            Post                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  collection      SavedCollection?       @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  savedCollection SavedCollection?       @relation("CollectionPosts", fields: [collectionId], references: [id], onDelete: SetNull, map: "SavedPost_savedCollection_fkey")
  collections     SavedPostCollection[]  // Many-to-many relation

  @@unique([accountId, postId])
  @@unique([userId, postId])
  @@index([accountId])
  @@index([userId])
  @@index([postId])
  @@index([savedAt])
}

// Junction table for many-to-many: SavedPost <-> SavedCollection
model SavedPostCollection {
  id           String   @id @default(cuid())
  savedPostId  String
  collectionId String
  addedAt      DateTime @default(now())

  savedPost  SavedPost       @relation(fields: [savedPostId], references: [id], onDelete: Cascade)
  collection SavedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([savedPostId, collectionId])
  @@index([savedPostId])
  @@index([collectionId])
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model ScheduledPost {
  id           String    @id @default(cuid())
  accountId    String?
  userId       String?
  content      String    @db.Text
  mediaUrls    String[]
  scheduledFor DateTime
  published    Boolean   @default(false)
  publishedAt  DateTime?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())

  // Timezone support
  timezone     String    @default("UTC")  // IANA timezone (e.g., "America/New_York")

  // Recurring post support
  recurrenceType    RecurrenceType @default(NONE)
  recurrenceEndDate DateTime?      // When to stop recurring (null = forever)
  parentPostId      String?        // Links recurring instances to parent

  // Track the published post
  publishedPostId   String?        // ID of the created Post after publishing

  @@index([accountId])
  @@index([userId])
  @@index([scheduledFor])
  @@index([status])
  @@index([parentPostId])
}

model Advertisement {
  id             String    @id @default(cuid())
  advertiserId   String
  campaignId     String?
  title          String
  content        String    @db.Text
  mediaUrl       String?
  targetUrl      String
  callToAction   String?
  placement      String[]  @default([])
  priority       Int       @default(0)
  targetAudience String?
  budget         Float     @default(0)
  spent          Float     @default(0)
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  conversions    Int       @default(0)
  status         String    @default("draft")
  type           String    @default("banner")
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([advertiserId])
  @@index([campaignId])
  @@index([status])
}

model ModerationLog {
  id           String   @id @default(cuid())
  moderatorId  String
  action       String
  targetType   String
  targetId     String
  reason       String?
  metadata     String?  @db.Text // JSON string with extra details (duration, scores, etc.)
  automated    Boolean  @default(false) // Whether this was an automated action
  appealable   Boolean  @default(true)  // Whether the user can appeal this action
  createdAt    DateTime @default(now())

  @@index([moderatorId])
  @@index([targetType, targetId])
  @@index([action])
