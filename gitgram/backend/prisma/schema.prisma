// ============================================
// TRENDING RANKING SYSTEM
// ============================================

enum TrendingTier {
  HOT_NOW
  TRENDING_TODAY
  THIS_WEEK
  RISING_STARS
}

enum TrendingEntityType {
  POST
  REPOSITORY
  USER
}

model TrendingEntry {
  id           String              @id @default(cuid())
  entityType   TrendingEntityType
  entityId     String
  tier         TrendingTier
  score        Float               @default(0)
  rawScore     Float               @default(0)   // Score before anti-gaming adjustments
  gamingPenalty Float              @default(0)    // Penalty applied for suspicious activity
  language     String?                            // For per-language trending
  topic        String?                            // For per-topic trending
  rank         Int                 @default(0)    // Position within tier
  metadata     Json?                              // Signal breakdown, debug info
  periodStart  DateTime                           // Start of the scoring window
  periodEnd    DateTime                           // End of the scoring window
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([entityType, entityId, tier, periodStart])
  @@index([tier, score])
  @@index([tier, language])
  @@index([tier, topic])
  @@index([entityType, tier])
  @@index([createdAt])
  @@index([rank])
}

model TrendingHistory {
  id           String              @id @default(cuid())
  entityType   TrendingEntityType
  entityId     String
  tier         TrendingTier
  score        Float
  rank         Int
  snapshotAt   DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([tier, snapshotAt])
  @@index([snapshotAt])
}

model EngagementAnomaly {
  id             String   @id @default(cuid())
  entityType     String                          // post, repository, user
  entityId       String
  anomalyType    String                          // burst_likes, coordinated_follows, velocity_spike, etc.
  severity       Float    @default(0)            // 0-1 severity score
  details        Json?                           // Detailed anomaly info
  actorIds       String[]                        // Users involved in the anomaly
  resolved       Boolean  @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  detectedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([anomalyType])
  @@index([resolved])
  @@index([detectedAt])
}

model TrendingSignalWeight {
  id          String   @id @default(cuid())
  signalName  String   @unique                   // e.g. "github_stars", "post_likes", etc.
  weight      Float    @default(1.0)
  category    String                              // github, social, engagement_quality, freshness, creator
  description String?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([active])
}

// ============================================
// MEDIA PIPELINE: Tracking & Lifecycle
// ============================================

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING       // Uploaded but not yet processed
  PROCESSING    // Currently being transcoded/optimized
  READY         // Processed and available
  FAILED        // Processing failed
  SOFT_DELETED  // Marked for deletion (retention period)
  EXPIRED       // Past retention, awaiting cleanup
}

enum TranscodeJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model Media {
  id              String      @id @default(cuid())
  userId          String
  type            MediaType
  status          MediaStatus @default(PENDING)
  originalUrl     String
  processedUrl    String?
  thumbnailUrl    String?
  webpUrl         String?

  // File metadata
  originalFilename String
  mimeType        String
  fileSize        Int         // bytes
  fileHash        String      // SHA-256 hash for dedup
  width           Int?
  height          Int?
  duration        Int?        // seconds, for video

  // Association
  postId          String?
  reelId          String?
  storyId         String?
  contentType     String?     // 'post', 'reel', 'story', 'avatar'

  // NSFW / moderation
  nsfwScore       Float?
  nsfwChecked     Boolean     @default(false)
  flagged         Boolean     @default(false)
  flagReason      String?

  // Lifecycle
  isPublic        Boolean     @default(false)
  softDeletedAt   DateTime?
  retentionDays   Int         @default(30)
  expiresAt       DateTime?

  // Multi-resolution URLs (JSON stored as string)
  resolutions     Json?       // { "150": "url", "480": "url", "720": "url", "1080": "url" }

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  transcodeJobs   TranscodeJob[]

  @@index([userId])
  @@index([fileHash])
  @@index([status])
  @@index([postId])
  @@index([reelId])
  @@index([storyId])
  @@index([softDeletedAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([userId, type, createdAt])
}

model TranscodeJob {
  id            String             @id @default(cuid())
  mediaId       String
  status        TranscodeJobStatus @default(QUEUED)
  resolution    String             // e.g. '720p', '1080p', '150x150'
  format        String             // e.g. 'mp4', 'webp'
  inputUrl      String
  outputUrl     String?
  outputSize    Int?
  errorMessage  String?
  attempts      Int                @default(0)
  maxAttempts   Int                @default(3)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  media         Media              @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([status])
  @@index([createdAt])
}

model MediaUploadQuota {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  imageCount      Int      @default(0)
  videoCount      Int      @default(0)
  totalBytes      BigInt   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model MediaFingerprint {
  id            String   @id @default(cuid())
  hash          String   @unique  // perceptual hash or SHA-256
  hashType      String   @default("sha256") // 'sha256', 'phash', 'blocklist'
  reason        String?  // Why it's blocked (if blocklist)
  isBlocked     Boolean  @default(false)
  reportCount   Int      @default(0)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([hash])
  @@index([isBlocked])
}

// ============================================
