# Gitgram mobile environment configuration.
# Copy to `.env` for local development, or set these in your EAS build profile
# (eas.json -> build.<profile>.env) for production builds.

# REST API base URL. MUST include the /api/v1 prefix the backend mounts on.
# Local dev example:
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
# Production example:
# EXPO_PUBLIC_API_URL=https://api.gitgram.app/api/v1

# GitHub OAuth client id for "Continue with GitHub" login.
# REQUIRED for GitHub auth to work in any build. Create an OAuth app at
# https://github.com/settings/developers and paste the client id here.
EXPO_PUBLIC_GITHUB_CLIENT_ID=

# Socket.IO server URL for realtime messaging, typing, and read receipts.
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001
# Production example:
# EXPO_PUBLIC_SOCKET_URL=https://api.gitgram.app

# EAS project id (optional, used by `eas build`).
# EAS_PROJECT_ID=
