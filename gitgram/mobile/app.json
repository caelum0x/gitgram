{
  "expo": {
    "name": "Gitgram",
    "slug": "gitgram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "gitgram",
    "entryPoint": "expo-router/entry",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gitgram.app",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.gitgram.app",
            "CFBundleURLSchemes": ["gitgram"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gitgram.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Gitgram to access your camera to take photos and record videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Gitgram to access your photos.",
          "savePhotosPermission": "Allow Gitgram to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "scheme": "gitgram"
  }
}
