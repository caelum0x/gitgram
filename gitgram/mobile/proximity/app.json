{
  "expo": {
    "name": "Gitgram",
    "slug": "gitgram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F0F1A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.gitgram.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Gitgram needs camera access to create story posts",
        "NSPhotoLibraryUsageDescription": "Gitgram needs photo library access to share images",
        "NSMicrophoneUsageDescription": "Gitgram needs microphone access for video reels"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0F1A"
      },
      "package": "dev.gitgram.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7C3AED"
        }
      ]
    ],
    "scheme": "gitgram",
    "extra": {
      "eas": {
        "projectId": "gitgram-app"
      }
    }
  }
}
