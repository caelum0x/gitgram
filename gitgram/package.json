{
  "name": "gitgram-monorepo",
  "version": "1.0.0",
  "description": "Gitgram - Instagram-like social app for GitHub projects",
  "private": true,
  "scripts": {
    "install:all": "npm run install:backend && npm run install:mobile && npm run install:web",
    "install:backend": "cd backend && npm install --legacy-peer-deps",
    "install:mobile": "cd mobile && npm install --legacy-peer-deps",
    "install:web": "cd web && npm install --legacy-peer-deps",
    "dev": "npm-run-all --parallel dev:backend dev:web",
    "dev:all": "npm-run-all --parallel dev:backend dev:web dev:mobile",
    "dev:backend": "cd backend && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "dev:web": "cd web && npm run dev",
    "build": "npm run build:backend && npm run build:web",
    "build:all": "npm run build:backend && npm run build:web && npm run build:mobile",
    "build:backend": "cd backend && npm run build",
    "build:web": "cd web && npm run build",
    "build:mobile": "cd mobile && npx expo export",
    "start": "npm-run-all --parallel start:backend start:web",
    "start:all": "npm-run-all --parallel start:backend start:web",
    "start:backend": "cd backend && npm start",
    "start:web": "cd web && npm start",
    "test": "npm run test:backend && npm run test:mobile",
    "test:backend": "cd backend && npm test",
    "test:mobile": "cd mobile && npm test",
    "test:watch": "npm-run-all --parallel test:backend:watch test:mobile:watch",
    "test:backend:watch": "cd backend && npm run test:watch",
    "test:mobile:watch": "cd mobile && npm run test:watch",
    "lint": "npm run lint:backend && npm run lint:mobile && npm run lint:web",
    "lint:backend": "cd backend && npm run lint",
    "lint:mobile": "cd mobile && npm run lint",
    "lint:web": "cd web && npm run lint",
    "lint:fix": "npm run lint:fix:backend && npm run lint:fix:mobile && npm run lint:fix:web",
    "lint:fix:backend": "cd backend && npm run lint:fix",
    "lint:fix:mobile": "cd mobile && npm run lint:fix",
    "lint:fix:web": "cd web && npm run lint -- --fix",
    "clean": "npm run clean:backend && npm run clean:mobile && npm run clean:web",
    "clean:backend": "cd backend && rm -rf dist node_modules",
    "clean:mobile": "cd mobile && rm -rf node_modules .expo",
    "clean:web": "cd web && rm -rf .next node_modules",
    "clean:all": "npm run clean && rm -rf node_modules",
    "prisma:generate": "cd backend && npm run prisma:generate",
    "prisma:migrate": "cd backend && npm run prisma:migrate",
    "prisma:studio": "cd backend && npm run prisma:studio",
    
    "fix:types": "cd backend && npm install --save-dev --legacy-peer-deps @types/compression @types/cookie-parser @types/csurf @types/helmet @types/speakeasy",
    "add:backend": "cd backend && npm install --legacy-peer-deps",
    "add:mobile": "cd mobile && npm install --legacy-peer-deps",
    "add:web": "cd web && npm install --legacy-peer-deps",
    "add:all": "npm run add:backend && npm run add:mobile && npm run add:web",
    "remove:backend": "cd backend && npm uninstall",
    "remove:mobile": "cd mobile && npm uninstall",
    "remove:web": "cd web && npm uninstall"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
