# =============================================================================
# Gitgram Web (Next.js) - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# All NEXT_PUBLIC_ variables are exposed to the browser bundle.
# =============================================================================

# ── API Connection [REQUIRED] ───────────────────────────────────────────────
# Backend API base URL (must include /api path)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── WebSocket [REQUIRED] ────────────────────────────────────────────────────
# Socket.IO server URL (same host as backend, without /api)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# GitHub OAuth App client ID (for login redirect flow)
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Google OAuth client ID (for login redirect flow)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# ── Monitoring ───────────────────────────────────────────────────────────────
# Sentry DSN for frontend error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics Measurement ID (optional, production only)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
