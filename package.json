{
  "name": "gitgram-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Gitgram AI monorepo — social platform for developers + AITimeMachine",
  "workspaces": [
    "gitgram/web",
    "gitgram/backend",
    "gitgram/gh-social",
    "gitgram/t3-base",
    "aitimemachine",
    "aitimemachine/api-server",
    "aitimemachine/mcp",
    "aitimemachine/gitnexus",
    "aitimemachine/gitnexus-web",
    "aitimemachine/gitnexus-shared",
    "aitimemachine/a2a",
    "aitimemachine/context7/packages/mcp",
    "aitimemachine/context7/packages/cli",
    "aitimemachine/context7/packages/sdk",
    "aitimemachine/tools/repo2txt"
  ],
  "scripts": {
    "test:all": "npm run test:gitgram-backend && npm run test:gitgram-web && npm run test:aitm",
    "test:gitgram-backend": "cd gitgram/backend && npm test",
    "test:gitgram-web": "cd gitgram/web && npm test",
    "test:aitm": "cd aitimemachine/api-server && npm test",

    "dev:gitgram": "concurrently \"npm run dev:gitgram-backend\" \"npm run dev:gitgram-web\"",
    "dev:gitgram-backend": "cd gitgram/backend && npm run dev",
    "dev:gitgram-web": "cd gitgram/web && npm run dev",
    "dev:gh-social": "cd gitgram/gh-social && npm run dev",
    "dev:t3": "cd gitgram/t3-base && npm run dev",
    "dev:proximity": "cd gitgram/mobile/proximity && npx expo start",

    "dev:aitm": "concurrently \"npm run dev:aitm-api\" \"npm run dev:aitm-mcp\" \"npm run dev:gitnexus\"",
    "dev:aitm-api": "cd aitimemachine/api-server && npm run dev",
    "dev:aitm-api:clean": "npm --prefix aitimemachine/api-server run dev:clean",
    "dev:aitm-mcp": "cd aitimemachine/mcp && npm run dev",
    "dev:gitnexus": "cd aitimemachine/gitnexus && npm run dev",
    "dev:gitnexus-web": "cd aitimemachine/gitnexus-web && npm run dev",
    "dev:a2a": "cd aitimemachine/a2a && npm run dev 2>/dev/null || echo 'a2a has no dev script — build with: cd aitimemachine/a2a && npm run build'",
    "dev:context7": "cd aitimemachine/context7/packages/mcp && npm run dev 2>/dev/null || node aitimemachine/context7/packages/mcp/dist/index.js",
    "dev:pal-mcp": "cd aitimemachine/pal-mcp-server && ./run-server.sh",
    "dev:repo2txt": "cd aitimemachine/tools/repo2txt && npm run dev",
    "dev:repo-to-text": "cd aitimemachine/tools/repo-to-text && python -m repo_to_text",

    "build:beads": "cd aitimemachine/beads && go build -o bd ./cmd/bd/ && echo 'beads bd binary built at aitimemachine/beads/bd'",
    "build:all": "npm run build:gitgram-backend && npm run build:gitgram-web && npm run build:aitm && npm run build:gitnexus",
    "build:gitgram-backend": "cd gitgram/backend && npm run build",
    "build:gitgram-web": "cd gitgram/web && npm run build",
    "build:aitm": "cd aitimemachine/api-server && npm run build",
    "build:gitnexus": "cd aitimemachine/gitnexus && npm run build",

    "lint:all": "npm run lint:gitgram-backend && npm run lint:aitm",
    "lint:gitgram-backend": "cd gitgram/backend && npm run lint",
    "lint:aitm": "cd aitimemachine/api-server && npx tsc --noEmit",

    "typecheck:all": "npm run typecheck:gitgram && npm run typecheck:aitm",
    "typecheck:gitgram": "npm run typecheck:gitgram-backend && npm run typecheck:gitgram-web",
    "typecheck:gitgram-backend": "cd gitgram/backend && npx tsc --noEmit",
    "typecheck:gitgram-web": "cd gitgram/web && npx tsc --noEmit",
    "typecheck:aitm": "cd aitimemachine && npx tsc --noEmit && cd api-server && npx tsc --noEmit",

    "smoke:local-launch": "bash scripts/smoke-local-launch.sh",
    "deploy:launch:staging": "bash scripts/deploy-launch.sh staging",
    "deploy:launch:production": "bash scripts/deploy-launch.sh production",
    "verify:aitm-packages": "cd aitimemachine && npm run verify:packages",
    "verify:aitm-local": "bash scripts/validate-prod-secrets.sh local",
    "verify:launch": "bash scripts/verify-launch-readiness.sh all core",
    "verify:launch:staging": "bash scripts/verify-launch-readiness.sh staging core",
    "verify:launch:production": "bash scripts/verify-launch-readiness.sh production core",
    "verify:launch:full": "RUN_TYPECHECK=1 bash scripts/verify-launch-readiness.sh all full",
    "verify:launch:staging:full": "RUN_TYPECHECK=1 bash scripts/verify-launch-readiness.sh staging full",
    "verify:launch:production:full": "RUN_TYPECHECK=1 bash scripts/verify-launch-readiness.sh production full",
    "verify:public-launch": "bash scripts/verify-public-launch.sh",
    "verify:secrets:staging": "bash scripts/validate-prod-secrets.sh staging full",
    "verify:secrets:production": "bash scripts/validate-prod-secrets.sh production full"
  }
}
